# Runtime knobs — copy to .env and adjust
# Configuration priority: CLI flags > .env > config.json

# DeepSeek API key — enables LLM-powered answers for free-text essay questions.
# If unset, essay fields get a generic fallback answer. Get a key at https://platform.deepseek.com/
API_KEY=

MAX_APPLICATIONS=10
HEADLESS=false
DRY_RUN=false
PLATFORMS=linkedin
LOG_LEVEL=info
DELAY_MIN_BETWEEN_APPS=5000
DELAY_MAX_BETWEEN_APPS=15000
SCREENSHOT_ON_ERROR=true
MAX_PAGES=5

# Discord webhook for run notifications (optional)
DISCORD_WEBHOOK_URL=
# Discord webhook for agent-internal channel (optional)
DISCORD_AGENT_INTERNAL_WEBHOOK_URL=
# Discord user ID for meowfis bot mentions (optional, omit to skip mentions)
DISCORD_MEOWFIS_USER_ID=

# Set AUTO_RUN=true when launched by Task Scheduler (enables time window guard)
# Leave unset or false for manual CLI runs
AUTO_RUN=false
