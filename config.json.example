{
  "user": {
    "firstName": "[FIRST_NAME]",
    "lastName": "[LAST_NAME]",
    "email": "[EMAIL]",
    "phone": "[PHONE]",
    "city": "[CITY]",
    "state": "[STATE]",
    "country": "[COUNTRY_CODE]",
    "zipCode": "[ZIP_CODE]",
    "linkedinUrl": "https://linkedin.com/in/[HANDLE]",
    "workAuthorization": "[WORK_AUTHORIZATION]",
    "requiresSponsorship": false,
    "willingToRelocate": true,
    "yearsOfExperience": "[YEARS_OF_EXPERIENCE]",
    "highestEducation": "[HIGHEST_EDUCATION]",
    "veteranStatus": "[VETERAN_STATUS]",
    "disabilityStatus": "[DISABILITY_STATUS]",
    "gender": "[GENDER]",
    "race": "[RACE_ETHNICITY]",
    "desiredSalary": "[DESIRED_SALARY]",
    "startDate": "[START_DATE]",
    "resumePath": "./resumes/resume.pdf"
  },

  "search": {
    "keywords": ["data scientist", "machine learning engineer", "data analyst"],
    "jobFilter": {
      "blockCompanies": [],
      "blockTitleKeywords": ["intern", "director", "VP", "recruiter"],
      "requireTitleKeywords": ["data scientist", "data analyst", "data engineer", "machine learning", "ML engineer", "AI engineer"]
    }
  },

  "platforms": {
    "linkedin": {
      "enabled": true,
      "maxApplicationsPerRun": 30,
      "geoId": "[LINKEDIN_GEO_ID]",
      "distance": 0.0,
      "f_SAL": ""
    },
    "indeed": {
      "enabled": true,
      "maxApplicationsPerRun": 30,
      "searchUrl": "https://www.indeed.com/jobs?q=[KEYWORDS]&l=[CITY]%2C+[STATE]&fromage=7"
    },
    "dice": {
      "enabled": true,
      "maxApplicationsPerRun": 30,
      "searchUrl": "https://www.dice.com/jobs?q=[KEYWORDS]&location=[CITY]%2C+[STATE]&radius=50&postedDate=SEVEN"
    },
    "jobright": {
      "enabled": true,
      "maxApplicationsPerRun": 20,
      "searchUrl": "https://jobright.ai/jobs"
    }
  },

  "behavior": {
    "minDelayBetweenActions": 1500,
    "maxDelayBetweenActions": 4000,
    "minDelayBetweenApplications": 5000,
    "maxDelayBetweenApplications": 15000,
    "typingSpeed": { "min": 50, "max": 150 },
    "scrollBehavior": "human",
    "maxRetries": 2,
    "screenshotOnError": true,
    "headless": true
  },

  "notifications": {
    "logToFile": true,
    "logToStdout": true
  }
}
